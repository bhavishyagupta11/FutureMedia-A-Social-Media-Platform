# SERVER ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)

# --- REQUIRED CORE CONFIGURATION ---
NODE_ENV=production
PORT=8080
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.pbbazrh.mongodb.net/futuremedia?retryWrites=true&w=majority&appName=FutureMediaProd
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_ORIGINS=https://futuremedia.vercel.app,https://futuremedia.com

# --- EMAIL CONFIGURATION (RESEND SMTP) ---
EMAIL_MODE=resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
FROM_EMAIL=noreply@futuremedia.bullishpath.in
FROM_NAME=FutureMedia

# --- MEDIA STORAGE (CLOUDINARY) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- OPTIONAL SERVICES ---
REDIS_URL=redis://localhost:6379
INTELLIGENCE_SERVICE_URL=http://localhost:8000
