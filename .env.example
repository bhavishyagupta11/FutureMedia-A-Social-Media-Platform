# ===================================================
# FutureMedia - Environment Configuration Template
# Copy to .env and customize values for your deployment
# ===================================================

# --- CORE BACKEND SETTINGS ---
NODE_ENV=production
PORT=8080

# Database: Default points to internal containerized MongoDB.
# To use MongoDB Atlas, replace with your mongodb+srv URI:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/futuremedia?retryWrites=true&w=majority
MONGO_URI=mongodb://mongodb:27017/futuremedia

# Authentication: Strong JWT secret key (must be at least 32 characters in production)
JWT_SECRET=futuremedia_super_secure_jwt_secret_key_change_in_production

# CORS Client Origins: Comma-separated list of allowed origins
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Canonical Frontend URL for emails & reset links (e.g. http://localhost:3000 or https://futuremedia.vercel.app)
CLIENT_URL=http://localhost:3000

# --- FRONTEND BUILD-TIME SETTINGS ---
REACT_APP_API_BASE_URL=http://localhost:8080
REACT_APP_SOCKET_URL=http://localhost:8080

# --- MEDIA STORAGE (CLOUDINARY) [OPTIONAL - FALLS BACK TO LOCAL DISK] ---
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- TRANSACTIONAL EMAIL (RESEND / SMTP) [OPTIONAL - FALLS BACK TO CONSOLE] ---
# EMAIL_MODE=resend
# RESEND_API_KEY=re_your_resend_api_key
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key
# FROM_EMAIL=noreply@futuremedia.com
# FROM_NAME=FutureMedia
